{
  "_comment": "SWSE reads this. 'passes' run in order over the captured 3D-scene frame, before HUD/menus are drawn (scene_only=true guarantees UI is untouched). Each effect has an in-overlay control (Home menu). Values here are defaults/saved state.",
  "scene_only": true,
  "overlay_key": "HOME",
  "passes": [
    {
      "id": "sharpen",
      "name": "Sharpening",
      "enabled": true,
      "shader": "shaders/sharpen.frag",
      "params": { "strength": { "value": 0.35, "min": 0.0, "max": 1.5 } }
    },
    {
      "id": "bloom",
      "name": "Bloom",
      "enabled": true,
      "shader": "shaders/bloom.frag",
      "params": {
        "threshold": { "value": 0.75, "min": 0.0, "max": 1.0 },
        "intensity": { "value": 0.5, "min": 0.0, "max": 2.0 }
      }
    },
    {
      "id": "ssao",
      "name": "Ambient Occlusion (SSAO)",
      "enabled": false,
      "shader": "shaders/ssao.frag",
      "needs_depth": true,
      "params": {
        "radius": { "value": 0.5, "min": 0.05, "max": 2.0 },
        "intensity": { "value": 1.0, "min": 0.0, "max": 3.0 }
      }
    },
    {
      "id": "ssgi",
      "name": "Global Illumination (SSGI)",
      "enabled": false,
      "shader": "shaders/ssgi.frag",
      "needs_depth": true,
      "params": {
        "intensity": { "value": 1.0, "min": 0.0, "max": 4.0 },
        "radius": { "value": 1.0, "min": 0.1, "max": 4.0 },
        "samples": { "value": 16, "min": 4, "max": 64 }
      }
    },
    {
      "id": "tonemap",
      "name": "Tonemap & Color Grade",
      "enabled": true,
      "shader": "shaders/tonemap.frag",
      "params": {
        "exposure": { "value": 1.0, "min": 0.2, "max": 3.0 },
        "saturation": { "value": 1.05, "min": 0.0, "max": 2.0 },
        "contrast": { "value": 1.05, "min": 0.5, "max": 2.0 }
      }
    }
  ]
}
