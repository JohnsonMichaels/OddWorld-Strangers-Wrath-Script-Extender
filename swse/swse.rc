// SWSE version resource - lets tools read the installed version from
// bin\dinput8.dll without running the game (right-click > Properties >
// Details, or [System.Diagnostics.FileVersionInfo]::GetVersionInfo()).
// The numbers come from swse_version.h, the one place the version is set.
#include <winver.h>
#include "swse_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     SWSE_VER_MAJOR,SWSE_VER_MINOR,SWSE_VER_PATCH,0
 PRODUCTVERSION  SWSE_VER_MAJOR,SWSE_VER_MINOR,SWSE_VER_PATCH,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Johnson Michaels"
            VALUE "FileDescription",  "SWSE - Stranger's Wrath Script Extender"
            VALUE "FileVersion",      SWSE_VERSION_FULL
            VALUE "InternalName",     "SWSE"
            VALUE "OriginalFilename", "dinput8.dll"
            VALUE "ProductName",      "SWSE (Stranger's Wrath Script Extender)"
            VALUE "ProductVersion",   SWSE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
