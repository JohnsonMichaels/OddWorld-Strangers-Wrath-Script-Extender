# PyInstaller scratch for the 4GB patcher (dist_patcher/ holds the built exe).
build_patcher/
# Mod Loader binaries. Rebuildable from studio.py via ModLoader.spec, and at
# ~18 MB each git would store every rebuild in full. Ship them as Releases.
oddforge/ModLoader.exe
release/ModLoader.exe
SWSE.zip
# HD texture working folders. These hold extracted game art and its upscaled
# derivatives, so they are large and they are Oddworld's assets - they should
# never be committed. The pipeline regenerates them from the user's own install
# (tools/hd_export.py -> upscaler -> tools/hd_pack.py).
hd_textures/

# AI/texture working folder: upscaler output and scratch, regenerated by the
# pipeline from the user's own install. Same reasoning as hd_textures/.
hd_work/
# Scratch dumps from RE sessions (texture censuses, frame grabs).
all_tga.txt
scratch_all_texnames.txt
foliage_candidates.txt
texmap_remaining.csv
frame_tex*.txt
frame*.tga


